generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Local default: SQLite. For production, set provider to "postgresql"
  // and DATABASE_URL to your Postgres connection (see docker-compose.yml).
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Better Auth ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  isPlatformAdmin Boolean @default(false)
  status          UserStatus @default(ACTIVE)

  sessions      Session[]
  accounts      Account[]
  memberships   BusinessMembership[]
  activityLogs  ActivityLog[] @relation("ActivityActor")
  staffProfiles StaffProfile[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeBusinessId String?

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

// ─── Platform core ───────────────────────────────────────────

model BusinessCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  domainSlug  String   @unique
  description String?
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  businesses    Business[]
  subcategories BusinessSubcategory[]
  modules       Module[]
  plans         Plan[]
  templates     WebsiteTemplate[]

  @@map("business_categories")
}

model BusinessSubcategory {
  id         String       @id @default(cuid())
  categoryId String
  name       String
  slug       String
  status     EntityStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  category   BusinessCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  businesses Business[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@map("business_subcategories")
}

model Business {
  id          String         @id @default(cuid())
  name        String
  slug        String
  email       String
  phone       String?
  address     String?
  logo        String?
  description String?
  status      BusinessStatus @default(ACTIVE)
  timezone    String         @default("Asia/Kathmandu")
  /// ISO 4217 currency code used for all tenant money display
  currency    String         @default("NPR")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  categoryId    String
  category      BusinessCategory     @relation(fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   BusinessSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  memberships     BusinessMembership[]
  roles           Role[]
  subscription    Subscription?
  businessModules BusinessModule[]
  features        BusinessFeature[]
  activityLogs    ActivityLog[]
  website         Website?
  customers       Customer[]
  facilities      Facility[]
  bookings        Booking[]
  membershipProducts MembershipProduct[]
  membershipsList Membership[]
  payments        Payment[]
  staffProfiles   StaffProfile[]
  availabilityRules AvailabilityRule[]
  cashbookAccounts CashbookAccount[]
  accountingTransactions AccountingTransaction[]
  checkIns        CheckIn[]
  leads           Lead[]
  products        Product[]
  posOrders       PosOrder[]
  notificationTemplates NotificationTemplate[]
  automationRules AutomationRule[]
  notificationLogs NotificationLog[]
  documentTemplates DocumentTemplate[]
  customerDocuments CustomerDocument[]
  customPrograms  CustomProgram[]

  @@unique([categoryId, slug])
  @@index([status])
  @@index([email])
  @@index([subcategoryId])
  @@map("businesses")
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

/// Platform currency catalog (ISO 4217). Businesses pick one for display.
model Currency {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  symbol    String?
  decimals  Int          @default(2)
  status    EntityStatus @default(ACTIVE)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status])
  @@map("currencies")
}

model BusinessMembership {
  id         String           @id @default(cuid())
  userId     String
  businessId String
  status     MembershipStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  roles       MembershipRole[]
  permissions MembershipPermission[]

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("business_memberships")
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  moduleKey   String
  description String?
  createdAt   DateTime @default(now())

  roles        RolePermission[]
  memberships  MembershipPermission[]

  @@index([moduleKey])
  @@map("permissions")
}

model Role {
  id          String   @id @default(cuid())
  businessId  String?
  name        String
  key         String
  description String?
  isSystem    Boolean  @default(false)
  isTemplate  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business?         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([businessId, key])
  @@index([businessId])
  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId String
  roleId       String

  membership BusinessMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

enum PermissionEffect {
  ALLOW
}

model MembershipPermission {
  id           String           @id @default(cuid())
  membershipId String
  permissionId String
  effect       PermissionEffect @default(ALLOW)
  createdAt    DateTime         @default(now())

  membership BusinessMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permission Permission         @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([membershipId, permissionId])
  @@index([membershipId])
  @@map("membership_permissions")
}

model Module {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  categoryId  String?
  isCore      Boolean  @default(false)
  sortOrder   Int      @default(0)
  icon        String?
  href        String?
  createdAt   DateTime @default(now())

  category        BusinessCategory? @relation(fields: [categoryId], references: [id])
  planModules     PlanModule[]
  businessModules BusinessModule[]

  @@index([categoryId])
  @@map("modules")
}

model Plan {
  id              String   @id @default(cuid())
  name            String
  key             String
  description     String?
  categoryId      String?
  priceCents      Float    @default(0)
  currency        String   @default("NPR")
  billingInterval BillingInterval @default(MONTHLY)
  limits          Json
  status          EntityStatus @default(ACTIVE)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category      BusinessCategory? @relation(fields: [categoryId], references: [id])
  planModules   PlanModule[]
  subscriptions Subscription[]

  @@unique([categoryId, key])
  @@map("plans")
}

enum BillingInterval {
  MONTHLY
  YEARLY
  LIFETIME
}

model PlanModule {
  planId   String
  moduleId String

  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([planId, moduleId])
  @@map("plan_modules")
}

model Subscription {
  id        String             @id @default(cuid())
  businessId String            @unique
  planId    String
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     Plan     @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  TRIAL
}

model BusinessModule {
  id         String   @id @default(cuid())
  businessId String
  moduleId   String
  enabled    Boolean  @default(true)
  source     ModuleSource @default(PLAN)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  module   Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([businessId, moduleId])
  @@index([businessId])
  @@map("business_modules")
}

enum ModuleSource {
  PLAN
  OVERRIDE
}

model BusinessFeature {
  id         String   @id @default(cuid())
  businessId String
  key        String
  enabled    Boolean  @default(true)
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, key])
  @@map("business_features")
}

model ActivityLog {
  id         String   @id @default(cuid())
  businessId String?
  userId     String?
  action     String
  module     String?
  entity     String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user     User?     @relation("ActivityActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

// ─── Website engine ──────────────────────────────────────────

model WebsiteTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  categoryId  String?
  description String?
  createdAt   DateTime @default(now())

  category BusinessCategory? @relation(fields: [categoryId], references: [id])
  websites Website[]

  @@map("website_templates")
}

model WebsiteTheme {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  tokens    Json?
  createdAt DateTime @default(now())

  websites Website[]

  @@map("website_themes")
}

model Website {
  id           String  @id @default(cuid())
  businessId   String  @unique
  templateId   String
  themeId      String?
  customDomain String? @unique
  content      Json?
  seoTitle     String?
  seoDescription String?
  indexable    Boolean @default(true)
  published    Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  template WebsiteTemplate  @relation(fields: [templateId], references: [id])
  theme    WebsiteTheme?    @relation(fields: [themeId], references: [id])

  @@map("websites")
}

// ─── Sports vertical ─────────────────────────────────────────

model Customer {
  id           String       @id @default(cuid())
  businessId   String
  name         String
  email        String?
  phone        String?
  notes        String?
  passwordHash String?
  status       EntityStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  memberships Membership[]
  payments    Payment[]
  checkIns    CheckIn[]
  posOrders   PosOrder[]
  documents   CustomerDocument[]
  customPrograms CustomProgram[]
  progressMetrics ProgressMetric[]

  @@index([businessId])
  @@index([businessId, email])
  @@map("customers")
}

model Facility {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  sport       String
  description String?
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  courts   Court[]
  checkIns CheckIn[]

  @@index([businessId])
  @@map("facilities")
}

model Court {
  id          String   @id @default(cuid())
  businessId  String
  facilityId  String
  name        String
  capacity    Int?
  hourlyRateCents Float @default(0)
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  bookings Booking[]
  availabilityRules AvailabilityRule[]

  @@index([facilityId])
  @@index([businessId])
  @@map("courts")
}

model AvailabilityRule {
  id         String   @id @default(cuid())
  businessId String
  courtId    String?
  dayOfWeek  Int
  startTime  String
  endTime    String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  court    Court?   @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([courtId])
  @@map("availability_rules")
}

model Booking {
  id          String        @id @default(cuid())
  businessId  String
  courtId     String?       // Made optional since a booking could be just for a PT
  staffProfileId String?    // For Personal Training bookings
  customerId  String?
  startAt     DateTime
  endAt       DateTime
  status      BookingStatus @default(CONFIRMED)
  notes       String?
  totalCents  Float         @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  court    Court?    @relation(fields: [courtId], references: [id])
  staffProfile StaffProfile? @relation(fields: [staffProfileId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([businessId, startAt])
  @@index([courtId, startAt, endAt])
  @@index([staffProfileId, startAt, endAt])
  @@index([status])
  @@map("bookings")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model MembershipProduct {
  id           String       @id @default(cuid())
  businessId   String
  name         String
  description  String?
  priceCents   Float        @default(0)
  durationDays Int          @default(30)
  benefits     Json?
  status       EntityStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@index([businessId])
  @@index([businessId, status])
  @@map("membership_products")
}

model Membership {
  id         String              @id @default(cuid())
  businessId String
  customerId String
  productId  String
  startDate  DateTime
  endDate    DateTime
  /// Price agreed at assignment time (snapshot; not live product price)
  priceCents Float               @default(0)
  status     MembershipLifecycle @default(ACTIVE)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  MembershipProduct @relation(fields: [productId], references: [id])
  payment  Payment?

  @@index([businessId])
  @@index([customerId])
  @@index([businessId, status])
  @@map("memberships")
}

enum MembershipLifecycle {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Payment {
  id           String        @id @default(cuid())
  businessId   String
  customerId   String?
  bookingId    String?
  membershipId String?       @unique
  amountCents  Float
  currency     String        @default("NPR")
  method       String?
  status       PaymentStatus @default(COMPLETED)
  reference    String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  booking    Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}

model StaffProfile {
  id              String       @id @default(cuid())
  businessId      String
  userId          String?
  name            String
  email           String?
  phone           String?
  title           String?
  hourlyRateCents Float        @default(0)
  status          EntityStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookings Booking[]

  @@index([businessId])
  @@index([userId])
  @@map("staff_profiles")
}

// ─── Accounting ──────────────────────────────────────────────

enum CashbookAccountType {
  CASH
  BANK
  WALLET
  OTHER
}

model CashbookAccount {
  id                  String              @id @default(cuid())
  businessId          String
  name                String
  type                CashbookAccountType @default(CASH)
  openingBalanceCents Float               @default(0)
  currency            String              @default("NPR")
  status              EntityStatus        @default(ACTIVE)
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  business     Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions AccountingTransaction[]

  @@index([businessId, status])
  @@map("cashbook_accounts")
}

enum AccountingTxnType {
  INCOME
  EXPENSE
}

model AccountingTransaction {
  id          String           @id @default(cuid())
  businessId  String
  accountId   String
  type        AccountingTxnType
  amountCents Float
  currency    String           @default("NPR")
  category    String?
  description String?
  reference   String?
  occurredAt  DateTime         @default(now())
  paymentId   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  account  CashbookAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([businessId, occurredAt])
  @@index([accountId, occurredAt])
  @@map("accounting_transactions")
}

// ─── Attendance ──────────────────────────────────────────────

model CheckIn {
  id         String    @id @default(cuid())
  businessId String
  customerId String
  facilityId String?
  checkInAt  DateTime  @default(now())
  checkOutAt DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  facility Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)

  @@index([businessId, checkInAt])
  @@index([customerId])
  @@map("check_ins")
}

// ─── CRM & Leads ─────────────────────────────────────────────

model Lead {
  id         String   @id @default(cuid())
  businessId String
  name       String
  email      String?
  phone      String?
  source     String?
  status     LeadStatus @default(NEW)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  followUps LeadFollowUp[]

  @@index([businessId, status])
  @@map("leads")
}

enum LeadStatus {
  NEW
  CONTACTED
  TRIAL
  CONVERTED
  LOST
}

model LeadFollowUp {
  id          String   @id @default(cuid())
  leadId      String
  notes       String
  scheduledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_follow_ups")
}

// ─── POS & Inventory ──────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  priceCents  Float    @default(0)
  sku         String?
  stockLevel  Int      @default(0)
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems PosOrderItem[]

  @@index([businessId, status])
  @@map("products")
}

model PosOrder {
  id          String   @id @default(cuid())
  businessId  String
  customerId  String?
  totalCents  Float    @default(0)
  status      PosOrderStatus @default(COMPLETED)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    PosOrderItem[]

  @@index([businessId, createdAt])
  @@map("pos_orders")
}

enum PosOrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

model PosOrderItem {
  id         String   @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int      @default(1)
  priceCents Float    @default(0)
  createdAt  DateTime @default(now())

  order   PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("pos_order_items")
}

// ─── Notifications & Automations ──────────────────────────────

model NotificationTemplate {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  type        NotificationType @default(EMAIL)
  subject     String?
  body        String
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  automationRules AutomationRule[]

  @@index([businessId])
  @@map("notification_templates")
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
}

model AutomationRule {
  id           String   @id @default(cuid())
  businessId   String
  name         String
  triggerEvent String   // e.g., "MEMBERSHIP_EXPIRING", "NEW_LEAD"
  conditions   Json?    // e.g., { "daysBefore": 3 }
  offsetDays   Int      @default(0)
  templateId   String
  isActive     Boolean  @default(true)
  status       EntityStatus @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  template NotificationTemplate @relation(fields: [templateId], references: [id])

  @@index([businessId, triggerEvent])
  @@map("automation_rules")
}

model NotificationLog {
  id          String   @id @default(cuid())
  businessId  String
  customerId  String?
  type        NotificationType
  recipient   String   // email address or phone number
  subject     String?
  body        String
  status      NotificationLogStatus @default(SENT)
  errorMessage String?
  sentAt      DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, sentAt])
  @@map("notification_logs")
}

enum NotificationLogStatus {
  SENT
  FAILED
  PENDING
}

// ─── Waivers & Documents (Phase 3) ───────────────────────────

model DocumentTemplate {
  id          String   @id @default(cuid())
  businessId  String
  name        String   // e.g. "Liability Waiver"
  content     String   // HTML or rich text
  isRequired  Boolean  @default(false)
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerDocuments CustomerDocument[]

  @@index([businessId])
  @@map("document_templates")
}

model CustomerDocument {
  id           String   @id @default(cuid())
  businessId   String
  customerId   String
  templateId   String
  signedAt     DateTime?
  ipAddress    String?
  signatureData String? // Base64 signature image or textual signature
  status       DocumentStatus @default(PENDING)
  createdAt    DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  template DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_documents")
}

enum DocumentStatus {
  PENDING
  SIGNED
  EXPIRED
}

// ─── Progress Tracking & Programs (Phase 3) ──────────────────

model CustomProgram {
  id          String   @id @default(cuid())
  businessId  String
  customerId  String
  name        String   // e.g. "12-Week Transformation"
  description String?
  content     Json     // e.g. { weeks: [ { days: [...] } ] }
  startDate   DateTime?
  endDate     DateTime?
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("custom_programs")
}

model ProgressMetric {
  id          String   @id @default(cuid())
  customerId  String
  metricName  String   // e.g. "Weight", "Body Fat", "Bench Press"
  value       Float
  unit        String   // e.g. "kg", "%", "lbs"
  recordedAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, metricName])
  @@map("progress_metrics")
}

// ─── Access Control (Phase 3) ────────────────────────────────

model AccessLog {
  id          String   @id @default(cuid())
  businessId  String
  customerId  String?
  facilityId  String?
  granted     Boolean
  reason      String?  // e.g. "Membership Expired"
  accessedAt  DateTime @default(now())

  @@index([businessId, accessedAt])
  @@map("access_logs")
}
