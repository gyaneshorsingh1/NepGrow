# Database

# Local (SQLite): file:./dev.db — keep prisma provider = "sqlite" in schema.prisma

# Production / cutover (Postgres): see docs/POSTGRES_CUTOVER.md

# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nepgrow?schema=public"

DATABASE_URL="file:./dev.db"



# Better Auth

BETTER_AUTH_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

BETTER_AUTH_URL="http://localhost:3000"



# App domains (comma-separated apex for marketing)

NEXT_PUBLIC_ROOT_DOMAIN="nepgrow.local"

NEXT_PUBLIC_APP_URL="http://app.nepgrow.local:3000"

NEXT_PUBLIC_ADMIN_URL="http://admin.nepgrow.local:3000"



# Transactional email (optional in local; without RESEND_API_KEY, emails log to console)

RESEND_API_KEY=""

EMAIL_FROM="NepGrow <onboarding@resend.dev>"

