# Database
# Local (SQLite): file:./dev.db  — keep prisma provider = "sqlite"
# Production (Postgres): postgresql://postgres:postgres@localhost:5432/nepgrow?schema=public
DATABASE_URL="file:./dev.db"

# Better Auth
BETTER_AUTH_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# App domains (comma-separated apex for marketing)
NEXT_PUBLIC_ROOT_DOMAIN="nepgrow.local"
NEXT_PUBLIC_APP_URL="http://app.nepgrow.local:3000"
NEXT_PUBLIC_ADMIN_URL="http://admin.nepgrow.local:3000"
